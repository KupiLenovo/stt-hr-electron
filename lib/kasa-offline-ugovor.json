              "smjena_id",
              "smjena_lokalni_uid",
              "stavke",
              "trazi_odobrenje"
            ]
          }
        ]
      },
      "dostupan": {
        "obavezna": true,
        "klijent_zove": false,
        "svojstvo": "boolean"
      },
      "kasaKase": {
        "obavezna": false,
