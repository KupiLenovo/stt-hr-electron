      "smjenaZatvori": {
        "obavezna": false,
        "klijent_zove": true,
        "argumenti": [
          {
            "ime": "u",
            "tip": "Record<string, unknown>",
            "polja": [
              "lokalni_uid",
              "napomena",
              "otvoreno_at",
              "otvorio_radnik_id",
              "pocetni_fond_fening",
              "prebrojano_fening",
              "radnik_id",
              "server_id",
              "skladiste_id",
              "uredjaj"
            ]
