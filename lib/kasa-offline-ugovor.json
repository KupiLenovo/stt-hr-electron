          {
            "ime": "a",
            "tip": "Artikal[]"
          }
        ]
      }
    }
  },
  "oblici": {
    "LokalnaSmjena": {
      "izvor": "client-v2/src/lib/kasa-offline.ts",
      "polja": {
        "lokalni_uid": "string",
        "skladiste_id": "number",
        "server_id": "number | null",
        "status": "'otvorena' | 'zatvorena'",
        "otvorio_radnik_id": "number | null",
        "otvoreno_at": "string",
        "pocetni_fond_fening": "number",
        "prebrojano_fening": "number | null",
        "zatvoreno_at": "string | null",
        "sukob": "number",
        "zatvorio_radnik_id?": "number | null",
        "napomena?": "string | null",
        "napomena_zatvaranja?": "string | null",
        "uredjaj?": "Record<string, unknown> | null",
        "tijelo?": "Record<string, unknown>"
      },
      "vracaju": [
        "smjenaAktivna",
        "smjenaOtvori",
        "smjenaPrimopredaja",
        "smjenaZatvori",
        "smjeneNesinhronizovane"
      ]
    },
    "KasaStanje": {
      "izvor": "client-v2/src/lib/kasa-offline.ts",
      "polja": {
        "spreman": "boolean",
        "zadnja_veza_at?": "string | null",
        "rok_do?": "string | null",
        "istekao?": "boolean",
        "lokacija_id?": "number | null",
        "radnika?": "number",
        "kasa?": "number"
      },
      "vracaju": [
        "kasaStanje"
      ]
    },
    "KasaRadnik": {
      "izvor": "client-v2/src/lib/kasa-offline.ts",
      "polja": {
        "id": "number",
        "ime": "string",
        "prezime?": "string | null",
        "uloga": "'admin' | 'voditelj' | 'radnik'",
        "lokacija_id?": "number | null"
      },
      "vracaju": [
        "kasaObnoviSesiju",
        "kasaPrijava",
        "kasaRadnici"
      ]
    },
    "LokalnaKorpa": {
      "izvor": "client-v2/src/lib/kasa-korpa.ts",
      "polja": {
        "kljuc": "string",
        "skladiste_id": "number",
        "vrsta": "'nacrt' | 'parkirana'",
        "naziv": "string",
        "sadrzaj": "unknown",
        "azuriran_at": "string"
      },
      "vracaju": [
        "korpeCitaj"
      ]
    },
    "RacunIzReda": {
      "izvor": "client-v2/src/lib/kasa-offline.ts",
      "polja": {
        "lokalni_uid?": "string",
        "smjena_lokalni_uid?": "string | null",
        "[k: string]": "unknown"
      },
      "vracaju": [
        "nesinhronizovani"
      ]
    }
  },
  "sinhronizacija": {
    "smjena": {
      "ruta": "POST /api/v1/maloprodaja/smjena/sync",
      "tijelo": "smjeneNesinhronizovane().smjene[i].tijelo (pravi desktop iz lokalne smjene) + racuni (dodaje klijent: računi iz reda s istim smjena_lokalni_uid)",
      "polja": {
        "lokalni_uid": {
          "tip": "string",
          "obavezno": true,
          "iz": "lokalni_uid"
        },
        "smjena_id": {
          "tip": "number",
          "iz": "server_id",
          "ako": "server_id"
        },
        "skladiste_id": {
          "tip": "number",
          "obavezno": true,
          "iz": "skladiste_id"
        },
        "otvoreno_at": {
          "tip": "string",
          "iz": "otvoreno_at"
        },
        "otvorio_korisnik_id": {
          "tip": "number",
          "iz": "otvorio_radnik_id"
        },
        "pocetni_fond_fening": {
          "tip": "number",
          "iz": "pocetni_fond_fening"
        },
        "napomena": {
          "tip": "string",
          "iz": "napomena",
          "prazno": "izostaje"
        },
        "racuni": {
          "tip": "racun[]",
          "dodaje": "klijent"
        },
        "zatvaranje": {
          "tip": "objekt",
          "ako": "status",
          "jednako": "zatvorena",
          "polja": {
            "zatvoreno_at": {
              "tip": "string",
              "iz": "zatvoreno_at"
            },
            "zatvorio_korisnik_id": {
              "tip": "number",
              "iz": "zatvorio_radnik_id"
            },
            "prebrojano_fening": {
              "tip": "number",
              "iz": "prebrojano_fening"
            },
            "napomena": {
              "tip": "string",
              "iz": "napomena_zatvaranja",
              "prazno": "izostaje"
            },
            "uredjaj": {
              "tip": "objekt",
              "iz": "uredjaj",
              "ako": "uredjaj"
            },
            "razlika_tereti": {
              "tip": "string",
              "iz": null,
              "napomena": "desktop ne šalje; server: nije poslano → radnik"
            }
          }
        }
      },
      "izvor_desktop": "stt-hr-electron lib/kasa-offline.js tijeloSynca (grana f11/mal-20-21)"
    },
    "racun": {
      "ruta": "POST /api/v1/maloprodaja/racuni/sync",
      "tijelo": {
        "racuni": "racun[]"
      },
      "kljuc": "lokalni_uid",
      "veza_smjene": "smjena_lokalni_uid",
      "polja_klijenta": [
        "kasa_uredjaj",
        "kes_verzija",
        "kolicina_potvrdjena",
        "korpa_id",
        "kupac_id",
        "kupon_kod",
        "lokalni_uid",
        "loyalty_kupac_id",
        "placanja",
        "popust_odobrenje_id",
        "popust_razlog",
        "razlog_ispod_nabavne",
        "skladiste_id",
        "smjena_id",
        "smjena_lokalni_uid",
        "stavke",
        "trazi_odobrenje"
      ],
      "polja_iz_reda": [
        "fiskalni_status",
        "fiskalni_drajver",
        "fiskalni_broj",
        "fiskalni_datum",
        "fiskalni_vrijeme",
        "qr_kod",
        "raw_odgovor",
        "fiskalni_greska",
        "fiskalni_potvrda",
        "uredjaj_prije",
        "fiskalni_pokusaj_at"
      ],
      "polja_servera": [
        "fiskalni_broj",
        "fiskalni_datum",
        "fiskalni_drajver",
        "fiskalni_greska",
        "fiskalni_pokusaj_at",
        "fiskalni_potvrda",
        "fiskalni_status",
        "fiskalni_uredjaj",
        "fiskalni_vrijeme",
        "lokalni_uid",
        "popust_odobrenje_id",
        "qr_kod",
        "raw_odgovor",
        "skladiste_id",
        "smjena_id",
        "smjena_lokalni_uid",
        "stavke",
        "tip",
        "uredjaj_prije"
      ]
    }
