{
  "name": "stt-hr",
  "version": "2.7.9",
  "description": "STT.BA HR Menadzment Sistem",
  "main": "main.js",
  "author": "STT d.o.o. Sarajevo",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^28.3.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "ba.stt.hr",
    "productName": "STT HR",
    "copyright": "(c) 2026 STT d.o.o. Sarajevo",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "app/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "requestedExecutionLevel": "requireAdministrator"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "STT HR",
      "language": "1050",
      "license": null,
      "include": "installer.nsh"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.business"
    },
    "publish": {
      "provider": "github",
      "owner": "KupiLenovo",
      "repo": "stt-hr-electron",
      "private": true,
      "releaseType": "release"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.3"
  }
}
